# Django settings. Copy to .env.backend (beside compose.yaml) in either repo. Never commit real values.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
PRODUCT_DOMAIN=localhost
PLATFORM_SUBDOMAIN=admin
CENTRAL_LOGIN_SUBDOMAIN=login

# Secrets (at least 32 characters each: openssl rand -hex 32)
INTERNAL_API_TOKEN=local-development-internal-token-change-me
JWT_SIGNING_KEY=local-development-jwt-signing-key-change-me
PROVIDER_SECRETS_KEY=local-development-provider-secrets-key-change-me
STAFF_DIRECTORY_KEY=local-development-staff-directory-key-change-me
JWT_ACCESS_TOKEN_MINUTES=15
# Seals authenticator secrets (issue 61): a Fernet key, made with
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TWO_FACTOR_SECRETS_KEY=6sQfnpfQHJV0PC1ZSb5VPSV4qMMbqmK_VOgWcGW4TIg=

# Platform Admin
PLATFORM_ADMIN_NAME=Platform Ops
PLATFORM_ADMIN_EMAIL=ops@platform.test
PLATFORM_ADMIN_PASSWORD=Local-Platform-2026!
# true or false: whether a Platform Admin made by the deploy starts with two-step login on
# (issue 61). Only used when it is created; true needs TWO_FACTOR_SECRETS_KEY.
PLATFORM_ADMIN_TWO_FACTOR_DEFAULT=false
# true or false: whether every new Staff member (the first Admin of a new office too) starts with
# two-step login on (issue 62). Staff who already exist are never changed; an Admin switches each
# person on or off on Employees. true needs TWO_FACTOR_SECRETS_KEY.
STAFF_TWO_FACTOR_DEFAULT=false

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailhog
EMAIL_PORT=1025

# Document storage
DOCUMENTS_BUCKET=crm-documents
DOCUMENTS_S3_REGION=ap-south-1
DOCUMENTS_S3_ENDPOINT_URL=http://minio:9000
DOCUMENTS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=crm-minio
AWS_SECRET_ACCESS_KEY=crm-minio-secret

# Job worker
JOB_POLL_SECONDS=5
JOB_TIMEOUT_SECONDS=900

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
