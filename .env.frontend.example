# Next.js settings for local development: safe placeholders only, used by compose as they are.
# To change a value, put just that line in .env.frontend (never committed); for pnpm dev copy this
# file to .env.local. Production never uses these.

BACKEND_BASE_URL=http://backend:8000
INTERNAL_API_TOKEN=local-development-internal-token-change-me
PRODUCT_DOMAIN=localhost
CENTRAL_LOGIN_SUBDOMAIN=login

# 32 bytes, base64: openssl rand -base64 32
AUTH_COOKIE_KEY=bG9jYWwtZGV2LWNvb2tpZS1rZXktY2hhbmdlLW1lISE=
AUTH_COOKIE_SECURE=false

LOG_LEVEL=info
